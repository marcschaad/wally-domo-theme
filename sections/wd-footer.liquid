{%- comment -%}
  WALLY DOMO: footer. Our section (2026-10-23), replaces Horizon's Footer + Utilities in the footer group.
  No email sign-up on purpose: the homepage already has one (WD Studio note). One ask per page.
  Brand sign-off, left to right: WD26 wordmark + "The Studio of Marc Schaad" byline + a studio line;
  up to two menus and a Studio column (Instagram, email); one flying pig from the studio banner's
  sprite (assets/wd-pig-line.png, 24 frames) that turns once when it comes into view and on hover,
  and takes you back to the top. Small print: copyright, Shopify policies, one edition fact.
  Wordmark and pig are CSS masks, so both follow the footer's ink colour.
  Every text has its own full type group (generated by wd-tools/gen_wd_sections.py).
  The site-wide "Footer" style in Header > Wally Domo fonts and type does not reach this section.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign rid = 'wd-ft-' | append: section.id

  if s.bg_color != blank
    assign bg = s.bg_color
  else
    assign bg = settings.color_palette.background | default: '#FAFAF7'
  endif
  if s.ink_color != blank
    assign ink = s.ink_color
  else
    assign ink = settings.color_palette.foreground | default: '#1A1A1A'
  endif
  if s.muted_color != blank
    assign muted = s.muted_color
  else
    assign muted = settings.color_palette.color1 | default: '#5E5A53'
  endif
  if s.line_color != blank
    assign rule = s.line_color
  else
    assign rule = settings.color_palette.color2 | default: '#E2E0DA'
  endif

  assign url_line = 'wd26-wordmark-line.svg' | asset_url
  assign url_stacked = 'wd26-wordmark.svg' | asset_url
  assign ratio_line = 988.92 | divided_by: 115.09
  assign ratio_stacked = 761.45 | divided_by: 361.37
  if s.d_version == 'line'
    assign d_url = url_line
    assign d_w = s.d_height | times: ratio_line | ceil
  else
    assign d_url = url_stacked
    assign d_w = s.d_height | times: ratio_stacked | ceil
  endif
  if s.m_version == 'line'
    assign m_url = url_line
    assign m_w = s.m_height | times: ratio_line | ceil
  else
    assign m_url = url_stacked
    assign m_w = s.m_height | times: ratio_stacked | ceil
  endif

  assign col1 = linklists[s.col1_menu]
  assign col2 = linklists[s.col2_menu]
  assign has_studio = false
  if s.ig_url != blank or s.show_email
    assign has_studio = true
  endif
  assign year = 'now' | date: '%Y'
-%}
<div
  id="{{ rid }}"
  class="wd-ft{% if s.top_line %} wd-ft--line{% endif %}"
  style="--wd-ft-bg: {{ bg }}; --wd-ft-ink: {{ ink }}; --wd-ft-muted: {{ muted }}; --wd-ft-rule: {{ rule }}; --wd-ft-top: {{ s.space_top }}px; --wd-ft-bottom: {{ s.space_bottom }}px; --wd-ft-dw: {{ d_w }}px; --wd-ft-dh: {{ s.d_height }}px; --wd-ft-mw: {{ m_w }}px; --wd-ft-mh: {{ s.m_height }}px; --wd-ft-durl: url('{{ d_url }}'); --wd-ft-murl: url('{{ m_url }}'); --wd-ft-pz: {{ s.pig_size }}px; --wd-ft-spt: {{ s.spin_secs }}s;"
>
  <div class="wd-ft__wrap">
    <div class="wd-ft__main">
      <div class="wd-ft__brand">
        {%- if s.show_wordmark -%}
          <a class="wd-ft__mark" href="{{ routes.root_url }}"><span class="visually-hidden">{{ s.copyright_name | default: shop.name | escape }}, home</span></a>
        {%- endif -%}
        {%- if s.byline_top != blank or s.byline_name != blank -%}
          <p class="wd-ft__byline">
            {%- if s.byline_top != blank -%}<span class="wd-ft__top">{{ s.byline_top | escape }}</span>{%- endif -%}
            {%- if s.byline_name != blank -%}<span class="wd-ft__name">{{ s.byline_name | escape }}</span>{%- endif -%}
          </p>
        {%- endif -%}
        {%- if s.studio_line != blank -%}<p class="wd-ft__line">{{ s.studio_line | escape }}</p>{%- endif -%}
      </div>

      {%- for col in (1..2) -%}
        {%- if col == 1 -%}
          {%- assign menu = col1 -%}{%- assign heading = s.col1_heading -%}
        {%- else -%}
          {%- assign menu = col2 -%}{%- assign heading = s.col2_heading -%}
        {%- endif -%}
        {%- if menu.links.size > 0 -%}
          <nav class="wd-ft__col" aria-label="{{ heading | default: menu.title | escape }}">
            {%- if heading != blank -%}<h2 class="wd-ft__head">{{ heading | escape }}</h2>{%- endif -%}
            <ul class="wd-ft__list" role="list">
              {%- for link in menu.links -%}
                <li><a class="wd-ft__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}

      {%- if has_studio -%}
        <div class="wd-ft__col">
          {%- if s.col3_heading != blank -%}<h2 class="wd-ft__head">{{ s.col3_heading | escape }}</h2>{%- endif -%}
          <ul class="wd-ft__list" role="list">
            {%- if s.ig_url != blank -%}
              <li><a class="wd-ft__link" href="{{ s.ig_url }}" target="_blank" rel="noopener">{{ s.ig_label | default: 'Instagram' | escape }}<span class="wd-ft__arrow" aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
            {%- endif -%}
            {%- if s.show_email and shop.email != blank -%}
              <li><a class="wd-ft__link" href="mailto:{{ shop.email }}">{{ s.email_label | default: shop.email | escape }}</a></li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if s.show_pig -%}
        {%- if s.pig_top -%}
          <a class="wd-ft__pig" href="#" data-spin="{{ s.pig_spin }}"{% if s.pig_caption == blank %} aria-label="Back to top"{% endif %}>
        {%- else -%}
          <span class="wd-ft__pig" data-spin="{{ s.pig_spin }}" aria-hidden="true">
        {%- endif -%}
            <span class="wd-ft__pigart" aria-hidden="true"></span>
            {%- if s.pig_caption != blank -%}<span class="wd-ft__cap">{{ s.pig_caption | escape }}</span>{%- endif -%}
        {%- if s.pig_top -%}</a>{%- else -%}</span>{%- endif -%}
      {%- endif -%}
    </div>

    <div class="wd-ft__base">
      <ul class="wd-ft__small-list" role="list">
        <li class="wd-ft__small">&copy; {{ year }} {{ s.copyright_name | default: shop.name | escape }}</li>
        {%- if s.show_policies -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<li><a class="wd-ft__small wd-ft__small-link" href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if s.fact != blank -%}<p class="wd-ft__small wd-ft__fact">{{ s.fact | escape }}</p>{%- endif -%}
      {%- if s.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="wd-ft__pay" role="list">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'wd-ft__pay-icon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #{{ rid }} { background: var(--wd-ft-bg); color: var(--wd-ft-ink); padding-block: var(--wd-ft-top) var(--wd-ft-bottom); }
  #{{ rid }}.wd-ft--line { border-top: 1px solid var(--wd-ft-rule); }
  #{{ rid }} .wd-ft__wrap { width: min(var(--page-content-width, 1200px), 100% - var(--page-margin, 20px) * 2); margin-inline: auto; }
  #{{ rid }} .wd-ft__main { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)) auto; gap: 40px 48px; align-items: start; }
  #{{ rid }} .wd-ft__brand { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; min-width: 0; }
  #{{ rid }} .wd-ft__mark { display: block; width: var(--wd-ft-dw); max-width: 100%; height: var(--wd-ft-dh); background-color: currentColor; color: var(--wd-ft-ink);
    -webkit-mask: var(--wd-ft-durl) left center / contain no-repeat; mask: var(--wd-ft-durl) left center / contain no-repeat; }
  #{{ rid }} .wd-ft__byline { margin: 0; display: flex; flex-direction: column; gap: 2px; }
  #{{ rid }} .wd-ft__top, #{{ rid }} .wd-ft__name { display: block; color: var(--wd-ft-ink); }
  #{{ rid }} .wd-ft__line { margin: 0; color: var(--wd-ft-muted); max-width: 32ch; }
  #{{ rid }} .wd-ft__col { min-width: 0; }
  #{{ rid }} .wd-ft__head { margin: 0 0 14px; color: var(--wd-ft-muted); }
  #{{ rid }} .wd-ft__list, #{{ rid }} .wd-ft__small-list, #{{ rid }} .wd-ft__pay { list-style: none; margin: 0; padding: 0; }
  #{{ rid }} .wd-ft__list { display: flex; flex-direction: column; gap: 6px; }
  #{{ rid }} .wd-ft__link, #{{ rid }} .wd-ft__small-link { color: var(--wd-ft-ink); text-decoration: none; text-underline-offset: 3px; text-decoration-thickness: 1px; overflow-wrap: anywhere; }
  #{{ rid }} .wd-ft__link:hover, #{{ rid }} .wd-ft__small-link:hover, #{{ rid }} .wd-ft__link[aria-current] { text-decoration-line: underline; }
  #{{ rid }} :is(.wd-ft__link, .wd-ft__small-link, .wd-ft__mark, .wd-ft__pig):focus-visible { outline: 2px solid var(--wd-ft-ink); outline-offset: 4px; }
  #{{ rid }} .wd-ft__pig { justify-self: end; display: flex; flex-direction: column; align-items: center; gap: 8px; color: var(--wd-ft-ink); text-decoration: none; }
  #{{ rid }} a.wd-ft__pig { cursor: pointer; }
  #{{ rid }} .wd-ft__pigart { display: block; width: var(--wd-ft-pz); aspect-ratio: 228 / 194; background-color: currentColor;
    -webkit-mask: url('{{ 'wd-pig-line.png' | asset_url }}') 0 0 / 2400% 100% no-repeat; mask: url('{{ 'wd-pig-line.png' | asset_url }}') 0 0 / 2400% 100% no-repeat; }
  #{{ rid }} .wd-ft__pig.is-spin .wd-ft__pigart { animation: wd-ft-spin var(--wd-ft-spt) steps(24) 1; }
  @keyframes wd-ft-spin { from { -webkit-mask-position: 0% 0; mask-position: 0% 0; } to { -webkit-mask-position: 104.3478% 0; mask-position: 104.3478% 0; } }
  #{{ rid }} .wd-ft__cap { color: var(--wd-ft-muted); }
  #{{ rid }} .wd-ft__base { margin-top: calc(var(--wd-ft-top) * 0.75); padding-top: 18px; border-top: 1px solid var(--wd-ft-rule); display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px 32px; }
  #{{ rid }} .wd-ft__small-list { display: flex; flex-wrap: wrap; gap: 6px 20px; }
  #{{ rid }} .wd-ft__small { color: var(--wd-ft-muted); margin: 0; }
  #{{ rid }} .wd-ft__small-link { color: var(--wd-ft-muted); }
  #{{ rid }} .wd-ft__pay { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 8px; }
  #{{ rid }} .wd-ft__pay-icon { display: block; width: 38px; height: 24px; }
  @media screen and (max-width: 1099px) {
    #{{ rid }} .wd-ft__main { grid-template-columns: repeat(3, minmax(0, 1fr)) auto; }
    #{{ rid }} .wd-ft__brand { grid-column: 1 / -1; }
  }
  @media screen and (max-width: 749px) {
    #{{ rid }} .wd-ft__main { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px; }
    #{{ rid }} .wd-ft__mark { width: var(--wd-ft-mw); height: var(--wd-ft-mh); -webkit-mask-image: var(--wd-ft-murl); mask-image: var(--wd-ft-murl); }
    #{{ rid }} .wd-ft__pig { justify-self: start; align-items: flex-start; }
    #{{ rid }} .wd-ft__base { flex-direction: column; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    #{{ rid }} .wd-ft__pig.is-spin .wd-ft__pigart { animation: none; }
  }
</style>

{%- if s.show_pig -%}
<script>
  (() => {
    const root = document.getElementById('{{ rid }}');
    const pig = root && root.querySelector('.wd-ft__pig');
    if (!pig) return;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mode = pig.dataset.spin;
    const spin = () => { if (!still && mode !== 'never' && !pig.classList.contains('is-spin')) pig.classList.add('is-spin'); };
    pig.addEventListener('animationend', () => pig.classList.remove('is-spin'));
    pig.addEventListener('pointerenter', spin);
    pig.addEventListener('focus', spin);
    if (mode === 'view' && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { spin(); io.disconnect(); }
      }, { threshold: 0.6 });
      io.observe(pig);
    }
    if (pig.tagName === 'A') {
      pig.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' });
        const target = document.getElementById('MainContent');
        if (target) { target.setAttribute('tabindex', '-1'); target.focus({ preventScroll: true }); }
      });
    }
  })();
</script>
{%- endif -%}

{%- comment -%}WD-TYPE START (generated by gen_wd_sections.py){%- endcomment -%}
{%- liquid
  assign wd_scope = '#shopify-section-' | append: section.id
  assign wd_sel_ty_top = wd_scope | append: ' .wd-ft__top'
  assign wd_sel_ty_name = wd_scope | append: ' .wd-ft__name'
  assign wd_sel_ty_line = wd_scope | append: ' .wd-ft__line'
  assign wd_sel_ty_head = wd_scope | append: ' .wd-ft__head'
  assign wd_sel_ty_link = wd_scope | append: ' :is(.wd-ft__link, .wd-ft__link *)'
  assign wd_sel_ty_cap = wd_scope | append: ' .wd-ft__cap'
  assign wd_sel_ty_small = wd_scope | append: ' :is(.wd-ft__small, .wd-ft__small *)'
-%}
<style>
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_top', sel: wd_sel_ty_top -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_name', sel: wd_sel_ty_name -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_line', sel: wd_sel_ty_line -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_head', sel: wd_sel_ty_head -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_link', sel: wd_sel_ty_link -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_cap', sel: wd_sel_ty_cap -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_small', sel: wd_sel_ty_small -%}
</style>
{%- comment -%}WD-TYPE END{%- endcomment -%}

