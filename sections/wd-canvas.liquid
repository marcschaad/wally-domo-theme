{%- comment -%}
  WALLY DOMO: Canvas (2026-10-23). Free placement on a 12-column grid, like a layout grid in Figma.
  Marc: Horizon felt rigid and the controls cumbersome. One section, any layout.
  Every block says where it sits: column (1-12), width in columns, row (0 = next free row),
  rows tall, alignment, nudge, bring to front. Blocks can overlap. Phones use a 6-column grid:
  each block picks its phone width and order (or hides).
  Blocks: Image, Heading, Text, Product, Button, Colour panel.
  Type: each text picks a Text style (Header > Wally Domo fonts and type) or Custom.
  Type settings for blocks are generated by wd-tools/gen_wd_sections.py (block_groups).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign page_bg = settings.color_palette.background | default: '#FAFAF7'
  assign ink = settings.color_palette.foreground | default: '#1A1A1A'
  assign graphite = settings.color_palette.color1 | default: '#5E5A53'
  assign series = s.series_color | default: ink
  assign text_c = s.text_color | default: ink
  assign row_css = 'auto'
  if s.row_height > 0
    assign row_css = s.row_height | append: 'px'
  endif
  assign rid = 'WdCanvas-' | append: section.id
-%}
<div
  id="{{ rid }}"
  class="wd-cv wd-cv--{{ s.width }}{% if request.design_mode and s.show_grid %} wd-cv--grid{% endif %}"
  style="
    --wd-cv-bg: {{ s.bg_color | default: 'transparent' }};
    --wd-cv-ink: {{ text_c }};
    --wd-cv-graphite: {{ graphite }};
    --wd-cv-series: {{ series }};
    --wd-cv-page: {{ page_bg }};
    --wd-cv-cgap: {{ s.col_gap }}px;
    --wd-cv-rgap: {{ s.row_gap }}px;
    --wd-cv-row: {{ row_css }};
    --wd-cv-top: {{ s.space_top }}px;
    --wd-cv-bottom: {{ s.space_bottom }}px;
  "
>
  <div class="wd-cv__wrap">
    <div class="wd-cv__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign bid = 'wdcv-' | append: block.id
          assign col = b.col | default: 1
          assign span = b.span | default: 6
          assign over = col | plus: span | minus: 13
          if over > 0
            assign span = span | minus: over
          endif
          assign row_rule = 'span ' | append: b.rows
          if b.row > 0
            assign row_rule = b.row | append: ' / span ' | append: b.rows
          endif
          assign pw = b.phone_width | default: '6'
        -%}
        <div
          id="{{ bid }}"
          class="wd-cv__item wd-cv__item--{{ block.type }}{% if pw == 'hide' %} wd-cv__item--phone-hide{% endif %}"
          style="--c: {{ col }} / span {{ span }}; --r: {{ row_rule }}; --pw: span {{ pw | replace: 'hide', '6' }}; --po: {{ b.phone_order | default: 0 }}; --ay: {{ b.align_y | default: 'start' }}; --ax: {{ b.align_x | default: 'stretch' }}; --dx: {{ b.nudge_x | default: 0 }}px; --dy: {{ b.nudge_y | default: 0 }}px;{% if b.front %} z-index: 2;{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- case block.type -%}
            {%- when 'image' -%}
              {%- liquid
                case b.aspect
                  when 'square'
                    assign ar = '1 / 1'
                  when '45'
                    assign ar = '4 / 5'
                  when '34'
                    assign ar = '3 / 4'
                  when '23'
                    assign ar = '2 / 3'
                  when '32'
                    assign ar = '3 / 2'
                  when '169'
                    assign ar = '16 / 9'
                  else
                    assign ar = 'auto'
                endcase
              -%}
              {%- if b.link != blank -%}<a class="wd-cv__media-link" href="{{ b.link }}">{%- endif -%}
              <div class="wd-cv__frame wd-cv__frame--{{ b.aspect }}{% if b.blend %} wd-cv__frame--blend{% endif %}" style="--ar: {{ ar }}; --mat: {{ b.mat }}px; --fit: {{ b.fit }}; --matc: {{ b.mat_color | default: '#ffffff' }};">
                {%- if b.image -%}
                  {{ b.image | image_url: width: 2400 | image_tag: widths: '400, 600, 800, 1200, 1600, 2000, 2400', sizes: '(min-width: 750px) 66vw, 100vw', class: 'wd-cv__img', alt: b.alt, loading: 'lazy' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'wd-cv__img wd-cv__img--placeholder' }}
                {%- endif -%}
              </div>
              {%- if b.caption != blank -%}<p class="wd-cv__caption">{{ b.caption | escape }}</p>{%- endif -%}
              {%- if b.link != blank -%}</a>{%- endif -%}

            {%- when 'heading' -%}
              {%- assign tag = b.tag | default: 'h2' -%}
              <{{ tag }} class="wd-cv__heading" style="--tc: {{ b.color | default: 'var(--wd-cv-ink)' }}; text-align: {{ b.text_align }}; max-width: {% if b.max_ch > 0 %}{{ b.max_ch }}ch{% else %}none{% endif %};">{{ b.text | escape | newline_to_br }}</{{ tag }}>
              <style>{%- assign sel = '#' | append: bid | append: ' .wd-cv__heading' -%}{%- render 'wd-type-pick', s: b, el: 'ty_head', sel: sel -%}</style>

            {%- when 'text' -%}
              <div class="wd-cv__text" style="--tc: {{ b.color | default: 'var(--wd-cv-ink)' }}; text-align: {{ b.text_align }}; max-width: {% if b.max_ch > 0 %}{{ b.max_ch }}ch{% else %}none{% endif %};">{{ b.text }}</div>
              <style>{%- assign sel = '#' | append: bid | append: ' :is(.wd-cv__text, .wd-cv__text *:not(a.button))' -%}{%- render 'wd-type-pick', s: b, el: 'ty_text', sel: sel -%}</style>

            {%- when 'product' -%}
              {%- assign p = b.product -%}
              {%- assign pc = b.color | default: series -%}
              <div class="wd-cv__product" style="--tc: {{ pc }}; text-align: {{ b.text_align }};">
                {%- if b.show_image -%}
                  <a class="wd-cv__frame" href="{{ p.url | default: '#' }}" tabindex="-1" aria-hidden="true" style="--ar: {% if b.aspect == 'square' %}1 / 1{% elsif b.aspect == '45' %}4 / 5{% else %}auto{% endif %}; --mat: {{ b.mat }}px; --fit: contain; --matc: #ffffff;">
                    {%- if p.featured_media -%}
                      {{ p.featured_media.preview_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 750px) 40vw, 100vw', class: 'wd-cv__img', alt: '', loading: 'lazy' }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'wd-cv__img wd-cv__img--placeholder' }}
                    {%- endif -%}
                  </a>
                {%- endif -%}
                {%- if b.show_type and p.type != blank -%}<p class="wd-type-eyebrow">{{ p.type | escape }}</p>{%- endif -%}
                <h3 class="wd-cv__ptitle"><a href="{{ p.url | default: '#' }}">{{ b.title | default: p.title | default: 'Pick a product' | escape }}</a></h3>
                {%- if b.line != blank -%}<p class="wd-cv__pline">{{ b.line | escape }}</p>{%- endif -%}
                {%- if b.show_price and p -%}<p class="wd-cv__pprice">{{ p.price | money }}</p>{%- endif -%}
                {%- if b.button_label != blank and p -%}
                  <a class="button button-custom wd-cta wd-cv__pbutton" href="{{ p.url }}" style="--button-border-color: {{ pc }}; --button-background-color: {{ pc }}; --button-color: {{ page_bg }};">{{ b.button_label | escape }}</a>
                {%- endif -%}
              </div>
              <style>
                {%- assign sel = '#' | append: bid | append: ' .wd-cv__ptitle' -%}{%- render 'wd-type-pick', s: b, el: 'ty_ptitle', sel: sel -%}
                {%- assign sel = '#' | append: bid | append: ' .wd-cv__pline' -%}{%- render 'wd-type-pick', s: b, el: 'ty_pline', sel: sel -%}
                {%- assign sel = '#' | append: bid | append: ' .wd-cv__pprice' -%}{%- render 'wd-type-pick', s: b, el: 'ty_pprice', sel: sel -%}
              </style>

            {%- when 'button' -%}
              {%- assign bc = b.color | default: series -%}
              <div class="wd-cv__buttons" style="text-align: {{ b.text_align }};">
                {%- if b.style == 'link' -%}
                  <a class="wd-cv__textlink" href="{{ b.link | default: '#' }}" style="color: {{ bc }};">{{ b.label | escape }}</a>
                {%- else -%}
                  <a class="button button-custom{% if b.style == 'outline' %} wd-cta{% endif %}" href="{{ b.link | default: '#' }}" style="--button-border-color: {{ bc }}; --button-background-color: {{ bc }}; --button-color: {{ page_bg }};">{{ b.label | escape }}</a>
                {%- endif -%}
              </div>

            {%- when 'panel' -%}
              <div class="wd-cv__panel" style="background: {{ b.color | default: series }}; opacity: {{ b.opacity | divided_by: 100.0 }};{% if b.min_h > 0 %} min-height: {{ b.min_h }}px;{% endif %}"></div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #{{ rid }} { background: var(--wd-cv-bg); color: var(--wd-cv-ink); padding-block: var(--wd-cv-top) var(--wd-cv-bottom); }
  #{{ rid }} .wd-cv__wrap { width: min(var(--page-content-width, 1200px), 100% - var(--page-margin, 20px) * 2); margin-inline: auto; }
  #{{ rid }}.wd-cv--full .wd-cv__wrap { width: 100%; }
  #{{ rid }} .wd-cv__grid { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: var(--wd-cv-row); column-gap: var(--wd-cv-cgap); row-gap: var(--wd-cv-rgap); }
  #{{ rid }} .wd-cv__item { position: relative; z-index: 1; grid-column: var(--c); grid-row: var(--r); align-self: var(--ay); justify-self: var(--ax); min-width: 0; transform: translate(var(--dx), var(--dy)); display: flex; flex-direction: column; }
  #{{ rid }} .wd-cv__item--panel { z-index: 0; align-self: stretch; justify-self: stretch; }
  #{{ rid }} .wd-cv__media-link { display: contents; color: inherit; text-decoration: none; }
  #{{ rid }} .wd-cv__frame { display: block; background: var(--matc); padding: var(--mat); flex: 1 1 auto; min-height: 0; }
  #{{ rid }} .wd-cv__frame--blend .wd-cv__img { mix-blend-mode: multiply; }
  #{{ rid }} .wd-cv__img { display: block; width: 100%; height: auto; aspect-ratio: var(--ar); object-fit: var(--fit); }
  #{{ rid }} .wd-cv__frame--fill { display: flex; }
  #{{ rid }} .wd-cv__frame--fill .wd-cv__img { height: 100%; min-height: 200px; }
  #{{ rid }} .wd-cv__item--image:has(.wd-cv__frame--fill) { align-self: stretch; }
  #{{ rid }} .wd-cv__caption { margin: 8px 0 0; color: var(--wd-cv-graphite); font-size: 12px; }
  #{{ rid }} .wd-cv__heading { margin: 0; color: var(--tc); }
  #{{ rid }} .wd-cv__text { color: var(--tc); }
  #{{ rid }} .wd-cv__text > :first-child { margin-top: 0; }
  #{{ rid }} .wd-cv__text > :last-child { margin-bottom: 0; }
  #{{ rid }} .wd-cv__text a { color: inherit; text-underline-offset: 3px; }
  #{{ rid }} .wd-cv__product { display: flex; flex-direction: column; gap: 8px; }
  #{{ rid }} .wd-cv__product .wd-cv__frame { margin-bottom: 8px; }
  #{{ rid }} .wd-cv__ptitle, #{{ rid }} .wd-cv__pline, #{{ rid }} .wd-cv__pprice { margin: 0; }
  #{{ rid }} .wd-cv__ptitle { color: var(--tc); }
  #{{ rid }} .wd-cv__ptitle a { color: inherit; text-decoration: none; }
  #{{ rid }} .wd-cv__pline { color: var(--wd-cv-graphite); }
  #{{ rid }} .wd-cv__pbutton { margin-top: 8px; width: fit-content; }
  #{{ rid }} .wd-cv__product[style*="center"] .wd-cv__pbutton { margin-inline: auto; }
  #{{ rid }} .wd-cv__textlink { text-underline-offset: 3px; }
  #{{ rid }} .wd-cv__panel { width: 100%; height: 100%; }
  #{{ rid }}.wd-cv--grid .wd-cv__grid::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 3;
    background: repeating-linear-gradient(to right, rgba(63, 99, 184, .08) 0, rgba(63, 99, 184, .08) calc((100% - 11 * var(--wd-cv-cgap)) / 12), transparent calc((100% - 11 * var(--wd-cv-cgap)) / 12), transparent calc((100% - 11 * var(--wd-cv-cgap)) / 12 + var(--wd-cv-cgap)));
  }
  @media screen and (max-width: 749px) {
    #{{ rid }} .wd-cv__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: auto; row-gap: calc(var(--wd-cv-rgap) * .75); }
    #{{ rid }} .wd-cv__item { grid-column: var(--pw); grid-row: auto; order: var(--po); transform: none; justify-self: stretch; }
    #{{ rid }} .wd-cv__item--phone-hide { display: none; }
    #{{ rid }} .wd-cv__item--panel { display: none; }
    #{{ rid }} .wd-cv__frame--fill .wd-cv__img { aspect-ratio: 4 / 5; height: auto; }
    #{{ rid }}.wd-cv--grid .wd-cv__grid::before { display: none; }
  }
</style>

{%- comment -%}WD-TYPE START (generated by gen_wd_sections.py){%- endcomment -%}
{%- liquid
  assign wd_scope = '#shopify-section-' | append: section.id

-%}
<style>

</style>
{%- comment -%}WD-TYPE END{%- endcomment -%}

{% schema %}
{
  "name": "WD Canvas",
  "class": "wd-canvas-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Free placement. The section is a 12-column grid. Each block says where it sits: column, width, row, rows tall. Blocks can overlap; tick Bring to front on the one that goes on top. Phones use 6 columns: each block picks its phone width and order."
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full screen width"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "col_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Row height",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 = each row fits its content. Set a height (e.g. 80) to place things precisely: a block 5 rows tall is then 5 × 80 plus the gaps."
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "Show column guides (editor only)",
      "default": true
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "info": "Empty = page colour."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "info": "Empty = ink."
    },
    {
      "type": "color",
      "id": "series_color",
      "label": "Series colour (product titles, buttons, panels)",
      "info": "One colour per body of work. Empty = ink."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "space_top",
      "label": "Space above",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "space_bottom",
      "label": "Space below",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Describe the image (for screen readers)"
        },
        {
          "type": "select",
          "id": "aspect",
          "label": "Shape",
          "options": [
            {
              "value": "natural",
              "label": "As uploaded"
            },
            {
              "value": "fill",
              "label": "Fill the cell (uses rows tall)"
            },
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "45",
              "label": "4:5"
            },
            {
              "value": "34",
              "label": "3:4"
            },
            {
              "value": "23",
              "label": "2:3"
            },
            {
              "value": "32",
              "label": "3:2"
            },
            {
              "value": "169",
              "label": "16:9"
            }
          ],
          "default": "natural"
        },
        {
          "type": "select",
          "id": "fit",
          "label": "Fit",
          "options": [
            {
              "value": "cover",
              "label": "Crop to the shape"
            },
            {
              "value": "contain",
              "label": "Show the whole image"
            }
          ],
          "default": "contain"
        },
        {
          "type": "range",
          "id": "mat",
          "label": "Mat around the image",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "color",
          "id": "mat_color",
          "label": "Mat colour",
          "info": "Empty = white."
        },
        {
          "type": "checkbox",
          "id": "blend",
          "label": "Blend white into the background",
          "default": false,
          "info": "For art shot on white. Leave off for photos."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        },
        {
          "type": "header",
          "content": "Position"
        },
        {
          "type": "range",
          "id": "col",
          "label": "Starts at column",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 1
        },
        {
          "type": "range",
          "id": "span",
          "label": "Width (columns)",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 7
        },
        {
          "type": "range",
          "id": "row",
          "label": "Starts at row",
          "min": 0,
          "max": 12,
          "step": 1,
          "default": 1,
          "info": "0 = the next free row."
        },
        {
          "type": "range",
          "id": "rows",
          "label": "Rows tall",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 1
        },
        {
          "type": "select",
          "id": "align_y",
          "label": "Up / down in its cell",
          "options": [
            {
              "value": "start",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Middle"
            },
            {
              "value": "end",
              "label": "Bottom"
            },
            {
              "value": "stretch",
              "label": "Fill"
            }
          ],
          "default": "start"
        },
        {
          "type": "select",
          "id": "align_x",
          "label": "Left / right in its cell",
          "options": [
            {
              "value": "stretch",
              "label": "Full width"
            },
            {
              "value": "start",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Centre"
            },
            {
              "value": "end",
              "label": "Right"
            }
          ],
          "default": "stretch"
        },
        {
          "type": "range",
          "id": "nudge_x",
          "label": "Nudge left / right",
          "min": -200,
          "max": 200,
          "step": 5,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "nudge_y",
          "label": "Nudge up / down",
          "min": -200,
          "max": 200,
          "step": 5,
          "unit": "px",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "front",
          "label": "Bring to front",
          "default": false
        },
        {
          "type": "header",
          "content": "On phones"
        },
        {
          "type": "select",
          "id": "phone_width",
          "label": "Width on phones",
          "options": [
            {
              "value": "6",
              "label": "Full"
            },
            {
              "value": "4",
              "label": "Two thirds"
            },
            {
              "value": "3",
              "label": "Half"
            },
            {
              "value": "2",
              "label": "One third"
            },
            {
              "value": "hide",
              "label": "Hide on phones"
            }
          ],
          "default": "6"
        },
        {
          "type": "range",
          "id": "phone_order",
          "label": "Order on phones",
          "min": 0,
          "max": 12,
          "step": 1,
          "default": 0,
          "info": "Lower comes first. 0 = same order as the list."
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Heading",
          "default": "We Lived in Brooklyn, Baby"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Tag (for search engines)",
          "options": [
            {
              "value": "h1",
              "label": "H1 (one per page)"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "p",
              "label": "Plain text"
            }
          ],
          "default": "h2"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Colour",
          "info": "Empty = section text colour."
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Centre"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "max_ch",
          "label": "Line length limit",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "ch",
          "default": 0,
          "info": "0 = no limit."
        },
        {
          "type": "header",
          "content": "Position"
        },
