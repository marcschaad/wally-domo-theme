{%- comment -%}
  WALLY DOMO: Editions. Our section (2026-10-22), replaces the nested Horizon "Custom section".
  Everything on one screen in the editor: heading, intro, series colour, card look, spacing,
  and full type controls for every text (font, size, weight, line height, tracking, case).
  One "Print" block per card (product + optional title, note and edition line).
  Colour rule: one colour per body of work. Titles + buttons use the series colour; the card is
  the series colour mixed into the page colour (tint strength). Buttons use the Dawn CTA style
  (snippets/wd-cta.liquid via .wd-cta).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign page_bg = settings.color_palette.background | default: '#FAFAF7'
  assign graphite = settings.color_palette.color1 | default: '#5E5A53'
  assign series = s.series_color | default: '#8A5A2B'
  case s.image_shape
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    else
      assign ratio = 'auto'
  endcase
-%}
<div
  class="wd-ed"
  style="
    --wd-ed-series: {{ series }};
    --wd-ed-tint: color-mix(in srgb, {{ series }} {{ s.tint }}%, {{ page_bg }});
    --wd-ed-graphite: {{ graphite }};
    --wd-ed-pad: {{ s.card_padding }}px;
    --wd-ed-gap: {{ s.card_gap }}px;
    --wd-ed-mat: {{ s.mat }}px;
    --wd-ed-blur: {{ s.coming_blur }}px;
    --wd-ed-ratio: {{ ratio }};
    --wd-ed-cols: {{ s.columns }};
    --wd-ed-top: {{ s.space_top }}px;
    --wd-ed-bottom: {{ s.space_bottom }}px;
  "
>
  <div class="wd-ed__wrap">
    {%- if s.series_line != blank or s.heading != blank or s.intro != blank -%}
      <div class="wd-ed__intro">
        {%- if s.series_line != blank -%}
          <p class="wd-ed__series">{{ s.series_line | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="wd-ed__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.intro != blank -%}
          <div class="wd-ed__lede">{{ s.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="wd-ed__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign title = block.settings.title | default: p.title | default: 'Pick a product'
          assign edition = block.settings.edition_line | default: s.edition_line
          assign eyebrow = block.settings.eyebrow | default: p.type
          assign coming = false
          if block.settings.status == 'coming'
            assign coming = true
            assign title = block.settings.title | default: s.coming_title
            assign eyebrow = block.settings.eyebrow
          endif
        -%}
        {%- if coming -%}
        <article class="wd-ed__card wd-ed__card--coming" {{ block.shopify_attributes }}>
          <div class="wd-ed__mat">
            {%- if block.settings.coming_image -%}
              {{ block.settings.coming_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw', class: 'wd-ed__img wd-ed__img--coming', alt: '', loading: 'lazy' }}
            {%- else -%}
              <span class="wd-ed__img wd-ed__blank" aria-hidden="true"></span>
            {%- endif -%}
          </div>
          <div class="wd-ed__details">
            {%- if eyebrow != blank -%}
              <p class="wd-ed__eyebrow">{{ eyebrow | escape }}</p>
            {%- endif -%}
            <h3 class="wd-ed__title">{{ title | escape }}</h3>
            {%- if block.settings.note != blank -%}
              <p class="wd-ed__note">{{ block.settings.note | escape }}</p>
            {%- endif -%}
            {%- assign coming_line = block.settings.coming_line | default: s.coming_line -%}
            {%- if coming_line != blank -%}
              <p class="wd-ed__coming">{{ coming_line | escape }}</p>
            {%- endif -%}
          </div>
        </article>
        {%- continue -%}
        {%- endif -%}
        <article class="wd-ed__card" {{ block.shopify_attributes }}>
          <a class="wd-ed__mat" href="{{ p.url | default: '#' }}" tabindex="-1" aria-hidden="true">
            {%- if p.featured_media -%}
              {{ p.featured_media.preview_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw', class: 'wd-ed__img', alt: '', loading: 'lazy' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'wd-ed__img wd-ed__img--placeholder' }}
            {%- endif -%}
          </a>
          <div class="wd-ed__details">
            {%- if s.show_type and eyebrow != blank -%}
              <p class="wd-ed__eyebrow">{{ eyebrow | escape }}</p>
            {%- endif -%}
            <h3 class="wd-ed__title"><a href="{{ p.url | default: '#' }}">{{ title | escape }}</a></h3>
            {%- if block.settings.note != blank -%}
              <p class="wd-ed__note">{{ block.settings.note | escape }}</p>
            {%- endif -%}
            {%- if edition != blank -%}
              <p class="wd-ed__edition">{{ edition | escape }}</p>
            {%- endif -%}
            {%- if s.show_price and p -%}
              <p class="wd-ed__price">{{ p.price | money }}</p>
            {%- endif -%}
          </div>
          {%- if s.button_label != blank and p -%}
            <a
              class="button button-custom wd-cta wd-ed__button"
              href="{{ p.url }}"
              style="--button-border-color: {{ series }}; --button-background-color: {{ series }}; --button-color: {{ page_bg }};"
            >{{ s.button_label | escape }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .wd-ed { padding-block: var(--wd-ed-top) var(--wd-ed-bottom); }
  .wd-ed__wrap { width: min(var(--page-content-width, 1200px), 100% - var(--page-margin, 20px) * 2); margin-inline: auto; display: flex; flex-direction: column; gap: 48px; }
  .wd-ed__intro { max-width: 66%; display: flex; flex-direction: column; gap: 12px; }
  .wd-ed__heading { margin: 0; }
  .wd-ed__series { margin: 0; color: var(--wd-ed-graphite); }
  .wd-ed__blank { display: block; min-height: 200px; background: color-mix(in srgb, var(--wd-ed-series) 8%, #fff); }
  .wd-ed__img--coming { filter: blur(var(--wd-ed-blur, 0px)); }
  .wd-ed__card--coming .wd-ed__mat { overflow: hidden; }
  .wd-ed__coming { margin: 0; color: var(--wd-ed-series); }
  .wd-ed__lede { color: var(--wd-ed-graphite); }
  .wd-ed__lede p { margin: 0; }
  .wd-ed__grid { display: grid; grid-template-columns: repeat(var(--wd-ed-cols), minmax(0, 1fr)); gap: var(--wd-ed-gap); align-items: stretch; }
  .wd-ed__card { display: flex; flex-direction: column; gap: 16px; padding: var(--wd-ed-pad); background: var(--wd-ed-tint); }
  .wd-ed__mat { display: block; padding: var(--wd-ed-mat); background: #fff; }
  .wd-ed__img { display: block; width: 100%; height: auto; aspect-ratio: var(--wd-ed-ratio); object-fit: contain; }
  .wd-ed__details { display: flex; flex-direction: column; gap: 8px; }
  .wd-ed__title { margin: 0; color: var(--wd-ed-series); }
  .wd-ed__title a { color: inherit; text-decoration: none; }
  .wd-ed__eyebrow { margin: 0; color: var(--wd-ed-graphite); }
  .wd-ed__note { margin: 0; color: var(--wd-ed-graphite); }
  .wd-ed__edition { margin: 0; color: var(--wd-ed-graphite); }
  .wd-ed__price { margin: 0; }
  .wd-ed__button { margin-top: auto; width: fit-content; }
  @media screen and (max-width: 749px) {
    .wd-ed__intro { max-width: none; }
    .wd-ed__grid { grid-template-columns: minmax(0, 1fr); }
    .wd-ed__card { padding: calc(var(--wd-ed-pad) * .66); }
  }
</style>

{%- comment -%}WD-TYPE START (generated by gen_wd_sections.py){%- endcomment -%}
{%- liquid
  assign wd_scope = '#shopify-section-' | append: section.id
  assign wd_sel_ty_series = wd_scope | append: ' .wd-ed__series'
  assign wd_sel_ty_heading = wd_scope | append: ' .wd-ed__heading'
  assign wd_sel_ty_intro = wd_scope | append: ' :is(.wd-ed__lede, .wd-ed__lede *)'
  assign wd_sel_ty_title = wd_scope | append: ' .wd-ed__title'
  assign wd_sel_ty_note = wd_scope | append: ' .wd-ed__note'
  assign wd_sel_ty_edition = wd_scope | append: ' .wd-ed__edition'
  assign wd_sel_ty_price = wd_scope | append: ' .wd-ed__price'
  assign wd_sel_ty_coming = wd_scope | append: ' .wd-ed__coming'
-%}
<style>
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_series', sel: wd_sel_ty_series -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_heading', sel: wd_sel_ty_heading -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_intro', sel: wd_sel_ty_intro -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_title', sel: wd_sel_ty_title -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_note', sel: wd_sel_ty_note -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_edition', sel: wd_sel_ty_edition -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_price', sel: wd_sel_ty_price -%}
  {%- render 'wd-type-pick', s: section.settings, el: 'ty_coming', sel: wd_sel_ty_coming -%}
</style>
{%- comment -%}WD-TYPE END{%- endcomment -%}

{% schema %}
{
  "name": "WD Editions",
  "class": "wd-editions-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "series_line",
      "label": "Series name (small line above the heading, optional)",
      "info": "e.g. Common Species. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Signed prints, in small numbers."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Started in Brooklyn. Now made in a studio on the West Coast. Every print below is signed, numbered and dated by hand.</p>"
    },
    {
      "type": "header",
      "content": "Series name type"
    },
    {
      "type": "select",
      "id": "ty_series_style",
      "label": "Style",
      "options": [
        {
          "value": "display",
          "label": "Display: big italic headline"
        },
        {
          "value": "headline",
          "label": "Headline"
        },
        {
          "value": "title_large",
          "label": "Title large"
        },
        {
          "value": "title",
          "label": "Title: piece names"
        },
        {
          "value": "title_small",
          "label": "Title small"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "note",
          "label": "Note: italic aside"
        },
        {
          "value": "label",
          "label": "Label: small caps"
        },
        {
          "value": "label_small",
          "label": "Label small: tiny caps"
        },
        {
          "value": "small",
          "label": "Small print"
        },
        {
          "value": "price",
          "label": "Price"
        },
        {
          "value": "custom",
          "label": "Custom (own controls)"
        }
      ],
      "default": "label",
      "info": "Styles are set once in Header > Wally Domo fonts and type > Text styles."
    },
    {
      "type": "select",
      "id": "ty_series_font",
      "label": "Font",
      "options": [
        {
          "value": "body",
          "label": "Broadacre (Regular; Medium at 450+)"
        },
        {
          "value": "arsenica-variable",
          "label": "Arsenica Variable"
        },
        {
          "value": "arsenica-variable-italic",
          "label": "Arsenica Variable Italic"
        },
        {
          "value": "arsenica-text",
          "label": "Arsenica Text"
