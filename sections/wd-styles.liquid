{%- comment -%}
  WALLY DOMO: text styles. Generated by wd-tools/gen_wd_type.py. Lives in the header group; no markup.
  Writes --wd-st-<style>-* variables; snippets/wd-type-pick applies them to any text set to that style.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  {%- render 'wd-type-el', s: s, el: 'st_display', prefix: 'display' -%}
  {%- render 'wd-type-el', s: s, el: 'st_headline', prefix: 'headline' -%}
  {%- render 'wd-type-el', s: s, el: 'st_title_large', prefix: 'title_large' -%}
  {%- render 'wd-type-el', s: s, el: 'st_title', prefix: 'title' -%}
  {%- render 'wd-type-el', s: s, el: 'st_title_small', prefix: 'title_small' -%}
  {%- render 'wd-type-el', s: s, el: 'st_body', prefix: 'body' -%}
  {%- render 'wd-type-el', s: s, el: 'st_note', prefix: 'note' -%}
  {%- render 'wd-type-el', s: s, el: 'st_label', prefix: 'label' -%}
  {%- render 'wd-type-el', s: s, el: 'st_label_small', prefix: 'label_small' -%}
  {%- render 'wd-type-el', s: s, el: 'st_small', prefix: 'small' -%}
  {%- render 'wd-type-el', s: s, el: 'st_price', prefix: 'price' -%}
  .wd-styles-section { display: contents; }
</style>

