<script>
  (function () {
    var root = document.getElementById('wd-sb-{{ section.id }}');
    if (!root || root.dataset.wdReady) return;
    root.dataset.wdReady = '1';
    /* Pivot height for the sky dial: bottom of the band */
    var stage = root.querySelector('.wd-sb__stage');
    function measure() { if (stage) root.style.setProperty('--wd-sbot', (stage.offsetTop + stage.offsetHeight) + 'px'); }
    measure();
    if (window.ResizeObserver) { new ResizeObserver(measure).observe(root); } else { window.addEventListener('resize', measure); }
    /* Give every cloud its own copy of its shape: Chrome won't colour <use> clones */
    root.querySelectorAll('.wd-sb__cl use').forEach(function (u) {
      var sym = document.getElementById((u.getAttribute('href') || '').slice(1));
      if (!sym) return;
      var g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      Array.prototype.forEach.call(sym.childNodes, function (n) { var c = n.cloneNode(true); if (c.removeAttribute) c.removeAttribute('fill'); g.appendChild(c); });
      u.parentNode.replaceChild(g, u);
    });
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* Day / night wheel follows the mouse: left of centre = counter-clockwise, right = clockwise, up to +boost at the edges */
    var boost = parseFloat(root.dataset.boost); if (isNaN(boost)) boost = 0.15;
    var dial = (root.getAnimations ? root.getAnimations() : []).filter(function (a) { return /wd-sb-(turn|day)/.test(a.animationName || ''); });
    var wRate = 1, wTarget = 1, wLoop = null, wLast = 0;
    function wStep(now) {
      var dt = Math.min(0.05, (now - wLast) / 1000); wLast = now;
      wRate += (wTarget - wRate) * Math.min(1, dt * 2.5);
      dial.forEach(function (a) { a.playbackRate = wRate; });
      if (Math.abs(wTarget - wRate) > 0.002) { wLoop = requestAnimationFrame(wStep); } else { wRate = wTarget; dial.forEach(function (a) { a.playbackRate = wRate; }); wLoop = null; }
    }
    function wGo() { if (!wLoop && dial.length) { wLast = performance.now(); wLoop = requestAnimationFrame(wStep); } }
    if (root.classList.contains('wd-sb--cycle')) {
      root.addEventListener('mousemove', function (e) {
        var b = root.getBoundingClientRect();
        var dx = Math.max(-1, Math.min(1, (e.clientX - (b.left + b.width / 2)) / (b.width / 2)));
        wTarget = (dx < 0 ? 1 : -1) * (1 + boost * Math.abs(dx));
        wGo();
      });
      root.addEventListener('mouseleave', function () { wTarget = 1; wGo(); });
    }
    /* Pigs: spin introTurns times on load, then glide onto the rest frame. After that they spin only while hovered or for a
       moment after a tap, and always come back to rest. Cap: 1.5 turns a second. The right pig's turntable is the clock;
       the left pig runs the same strip backwards, held at frame (14 - right frame), so it rests on 14 - pig_rest. */
    var spt = parseFloat(root.dataset.spt) || 5;
    var D = spt * 1000;
    var cap = 1.5;
    var hov = parseFloat(root.dataset.hov); if (isNaN(hov)) hov = 0.25;
    var introTurns = parseFloat(root.dataset.intro); if (isNaN(introTurns)) introTurns = 2;
    var rest = parseInt(root.dataset.rest, 10); if (isNaN(rest)) rest = 4; rest = ((rest % 24) + 24) % 24;
    var base = 1 / spt, tps = base, impulse = 0, hover = false, loop = null, last = 0, landed = false;
    var sweepAnims = [];
    root.querySelectorAll('.wd-sb__sweep').forEach(function (el) { (el.getAnimations ? el.getAnimations() : []).forEach(function (a) { if (/wd-sb-sweep/.test(a.animationName || '')) sweepAnims.push(a); }); });
    var cRate = 1;
    function setSweep(r) { sweepAnims.forEach(function (a) { a.playbackRate = r; }); }
    var introUntil = performance.now() + introTurns * spt * 1000;
    function spins(sel) { var out = []; root.querySelectorAll(sel).forEach(function (el) { (el.getAnimations ? el.getAnimations() : []).forEach(function (a) { if (/spin/.test(a.animationName || '')) out.push(a); }); }); return out; }
    var rAnims = spins('.wd-sb__pig--r .wd-sb__fill, .wd-sb__pig--r .wd-sb__line');
    var lAnims = spins('.wd-sb__pig--l .wd-sb__fill, .wd-sb__pig--l .wd-sb__line');
    function setRate(r) { rAnims.forEach(function (a) { a.playbackRate = r; }); lAnims.forEach(function (a) { a.playbackRate = -r; }); }
    function phase() { var a = rAnims[0]; if (!a || a.currentTime == null) return 0; var t = a.currentTime % D; if (t < 0) t += D; return t / D; }
    function syncLeft() { var q = ((15 / 24 - phase()) % 1 + 1) % 1; lAnims.forEach(function (a) { a.currentTime = (1000 + q) * D; }); }
    function seekRest() { rAnims.forEach(function (a) { var ct = a.currentTime || 0; a.currentTime = Math.floor(ct / D) * D + (rest + 0.5) / 24 * D; }); syncLeft(); }
    function run() {
      if (loop) return;
      last = performance.now();
      loop = requestAnimationFrame(function step(now) {
        var dt = Math.min(0.05, (now - last) / 1000); last = now;
        impulse *= Math.exp(-dt / 0.6);
        var intro = now < introUntil;
        var active = intro || hover || Math.abs(impulse) > 0.02;
        cRate += ((active ? 1 : 0) - cRate) * Math.min(1, dt * (active ? 3 : 1));
        setSweep(cRate);
        var target = 0;
        if (active) {
          landed = false;
          target = Math.max(0, Math.min(cap, (intro ? base : 0) + (hover ? base + hov : 0) + impulse));
        } else if (!landed) {
          var p = phase(), f = Math.floor(p * 24) % 24;
          if (f === rest && tps < 0.3) { landed = true; tps = 0; setRate(0); seekRest(); }
          else { var d = ((rest + 0.5) / 24 - p + 1) % 1; target = Math.max(0.08, Math.min(Math.max(base, 0.2), d * 1.6)); }
        }
        if (!landed) {
          tps += (target - tps) * Math.min(1, dt * (Math.abs(target) < Math.abs(tps) ? 1.5 : 4));
          setRate(tps * spt);
        }
        if (landed && cRate < 0.004) { cRate = 0; setSweep(0); loop = null; return; }
        loop = requestAnimationFrame(step);
      });
    }
    function kick(d) { impulse = Math.max(0, Math.min(cap, impulse + d)); run(); }
    if (introTurns > 0) { setRate(tps * spt); syncLeft(); run(); } else { tps = 0; setRate(0); seekRest(); landed = true; cRate = 0; setSweep(0); }
    root.querySelectorAll('.wd-sb__pig').forEach(function (p) {
      p.addEventListener('mouseenter', function () { hover = true; run(); });
      p.addEventListener('mouseleave', function () { hover = false; run(); });
    });
    root.querySelectorAll('[data-wd-kick]').forEach(function (b) { b.addEventListener('click', function () { kick(0.6); }); });
  })();
</script>

{% schema %}
{
  "name": "WD Studio banner",
  "tag": "div",
  "class": "wd-studio-banner-section",
  "settings": [
    { "type": "select", "id": "centre", "label": "What sits in the middle", "options": [ { "value": "wd26", "label": "WD26 lockup (The Studio of Marc Schaad)" }, { "value": "signup", "label": "Coming soon + sign-up" } ], "default": "wd26" },
    { "type": "color", "id": "background", "label": "Sky", "default": "#b5bcd2" },
    { "type": "color", "id": "ink", "label": "Ink (lockup)", "default": "#191f24" },
    { "type": "range", "id": "grain", "label": "Grain", "min": 0, "max": 60, "step": 1, "unit": "%", "default": 22 },

    { "type": "header", "content": "Desktop", "info": "Screens 600px and wider: check these in the editor's desktop view. Pixels on a 1440px-wide screen; everything shrinks together on narrower windows. Nothing here changes phones." },
    { "type": "range", "id": "d_height", "label": "Banner height", "min": 40, "max": 1000, "step": 10, "unit": "px", "default": 130 },
    { "type": "select", "id": "d_layout", "label": "Lockup layout", "options": [ { "value": "line", "label": "One line" }, { "value": "stacked", "label": "Stacked" } ], "default": "line" },
    { "type": "range", "id": "d_lock_width", "label": "Lockup width", "min": 100, "max": 1000, "step": 10, "unit": "px", "default": 420 },
    { "type": "range", "id": "d_lock_y", "label": "Lockup up (−) / down (+)", "min": -200, "max": 200, "step": 4, "unit": "px", "default": 0, "info": "0 = centred in the banner." },
    { "type": "range", "id": "d_pig_size", "label": "Pig size", "min": 20, "max": 300, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "d_pig_dist", "label": "Pigs: distance from centre", "min": 0, "max": 700, "step": 10, "unit": "px", "default": 310 },
    { "type": "range", "id": "d_pig_y", "label": "Pigs up (−) / down (+)", "min": -200, "max": 200, "step": 4, "unit": "px", "default": 0, "info": "0 = centred in the banner." },
    { "type": "range", "id": "d_cloud", "label": "Cloud size", "min": 30, "max": 250, "step": 5, "unit": "%", "default": 90 },

    { "type": "header", "content": "Phones", "info": "Screens under 600px: switch the editor to mobile view (phone icon, top bar) to see these. Real pixels on the phone. Nothing here changes desktop." },
    { "type": "range", "id": "m_height", "label": "Banner height", "min": 40, "max": 400, "step": 5, "unit": "px", "default": 120 },
    { "type": "select", "id": "m_layout", "label": "Lockup layout", "options": [ { "value": "stacked", "label": "Stacked" }, { "value": "line", "label": "One line" } ], "default": "stacked" },
    { "type": "range", "id": "m_lock_width", "label": "Lockup width", "min": 60, "max": 360, "step": 5, "unit": "px", "default": 170 },
    { "type": "range", "id": "m_lock_y", "label": "Lockup up (−) / down (+)", "min": -100, "max": 100, "step": 2, "unit": "px", "default": 0, "info": "0 = centred in the banner." },
