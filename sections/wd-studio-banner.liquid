    { "type": "range", "id": "m_pig_y", "label": "Pigs up (−) / down (+)", "min": -100, "max": 100, "step": 2, "unit": "px", "default": 0, "info": "0 = centred in the banner." },
    { "type": "range", "id": "m_cloud", "label": "Cloud size", "min": 30, "max": 250, "step": 5, "unit": "%", "default": 65 },

    { "type": "header", "content": "Pigs", "info": "Colour and motion, same on every screen." },
    { "type": "color", "id": "pig_light", "label": "Body, lit side", "default": "#d7dfdc" },
    { "type": "color", "id": "pig_shade", "label": "Body, shaded side", "default": "#869798" },
    { "type": "range", "id": "intro_turns", "label": "Turns on page load", "min": 0, "max": 5, "step": 1, "default": 2 },
    { "type": "range", "id": "pig_rest", "label": "Rest pose (frame)", "min": 0, "max": 23, "step": 1, "default": 4, "info": "Right pig stops on this frame, left pig on its mirror (14 minus it). 4 = three-quarter, facing out." },
    { "type": "range", "id": "secs_per_turn", "label": "Seconds per turn", "min": 1, "max": 12, "step": 0.5, "unit": "s", "default": 5 },
    { "type": "range", "id": "hover_boost", "label": "Extra spin on hover", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 25 },

    { "type": "header", "content": "Clouds", "info": "Size is set per screen above." },
    { "type": "checkbox", "id": "clouds", "label": "Show clouds", "default": true },
    { "type": "range", "id": "cloud_count", "label": "How many", "min": 3, "max": 24, "step": 1, "default": 12, "info": "Split across three depth layers. 9-12 reads as sky.", "visible_if": "{{ section.settings.clouds }}" },
    { "type": "select", "id": "cloud_motion", "label": "Motion", "options": [ { "value": "stepped", "label": "Stop-motion" }, { "value": "smooth", "label": "Smooth" } ], "default": "stepped", "visible_if": "{{ section.settings.clouds }}" },
    { "type": "range", "id": "cloud_fps", "label": "Stop-motion frame rate (far layer)", "min": 2, "max": 24, "step": 1, "unit": "fps", "default": 8, "info": "Middle layer 1.5x, near 2x.", "visible_if": "{{ section.settings.clouds and section.settings.cloud_motion == 'stepped' }}" },
    { "type": "range", "id": "cloud_depth", "label": "Depth (speed gap between layers)", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 60, "visible_if": "{{ section.settings.clouds }}" },
    { "type": "range", "id": "cloud_secs", "label": "Seconds per pass", "min": 20, "max": 140, "step": 5, "unit": "s", "default": 75, "info": "Middle layer, while the pigs spin.", "visible_if": "{{ section.settings.clouds }}" },
    { "type": "color", "id": "cloud_tint_1", "label": "Cloud 1 tint", "default": "#ffeeed", "visible_if": "{{ section.settings.clouds }}" },
    { "type": "color", "id": "cloud_tint_2", "label": "Cloud 2 tint", "default": "#dbccd8", "visible_if": "{{ section.settings.clouds }}" },
    { "type": "color", "id": "cloud_tint_3", "label": "Cloud 3 tint", "default": "#fff7e0", "visible_if": "{{ section.settings.clouds }}" },
    { "type": "color", "id": "cloud_tint_4", "label": "Cloud 4 tint", "default": "#ffeecc", "visible_if": "{{ section.settings.clouds }}" },

    { "type": "header", "content": "Day and night" },
    { "type": "checkbox", "id": "day_night", "label": "Day and night cycle", "default": true, "info": "Off = flat sky." },
    { "type": "range", "id": "day_secs", "label": "One full day", "min": 12, "max": 240, "step": 3, "unit": "s", "default": 60, "visible_if": "{{ section.settings.day_night }}" },
    { "type": "range", "id": "spin_boost", "label": "Speeds up toward the mouse", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 15, "visible_if": "{{ section.settings.day_night }}" },
    { "type": "color", "id": "sky_night", "label": "Night sky", "default": "#1e2741", "visible_if": "{{ section.settings.day_night }}" },
    { "type": "color", "id": "sky_dusk", "label": "Sunset / sunrise", "default": "#e9b6a2", "visible_if": "{{ section.settings.day_night }}" },
    { "type": "color", "id": "ink_night", "label": "Ink at night", "default": "#f1f4f7", "visible_if": "{{ section.settings.day_night }}" },
    { "type": "range", "id": "star_count", "label": "Stars", "min": 0, "max": 14, "step": 1, "default": 8, "visible_if": "{{ section.settings.day_night }}" },
    { "type": "color", "id": "star_light", "label": "Near stars", "default": "#fff8e7", "visible_if": "{{ section.settings.day_night }}" },
    { "type": "color", "id": "star_dark", "label": "Far stars", "default": "#8a97c4", "visible_if": "{{ section.settings.day_night }}" },

    { "type": "header", "content": "Coming soon + sign-up", "info": "Only when the middle is Coming soon + sign-up (the password page). Heading sizes are desktop px; phones use about half." },
    { "type": "text", "id": "cs_heading", "label": "Heading", "default": "Coming soon", "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "select", "id": "cs_font", "label": "Heading font", "options": [ { "value": "arsenica-variable", "label": "Arsenica Variable" }, { "value": "arsenica-text", "label": "Arsenica Text" }, { "value": "broadacre", "label": "Broadacre" }, { "value": "body", "label": "Same as body text" } ], "default": "arsenica-variable", "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "range", "id": "cs_size", "label": "Heading size", "min": 24, "max": 120, "step": 1, "unit": "px", "default": 46, "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "range", "id": "cs_weight", "label": "Heading weight", "min": 100, "max": 800, "step": 10, "default": 380, "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "checkbox", "id": "cs_italic", "label": "Heading in italic", "default": false, "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "range", "id": "cs_line_height", "label": "Heading line height", "min": 70, "max": 200, "step": 5, "unit": "%", "default": 100, "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "range", "id": "cs_tracking", "label": "Heading tracking", "min": -100, "max": 200, "step": 5, "default": 0, "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "select", "id": "cs_case", "label": "Heading case", "options": [ { "value": "none", "label": "As typed" }, { "value": "uppercase", "label": "All caps" }, { "value": "lowercase", "label": "All lowercase" }, { "value": "capitalize", "label": "Initial caps" } ], "default": "none", "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "range", "id": "cs_gap", "label": "Heading up (−) / down (+)", "min": -60, "max": 60, "step": 2, "unit": "px", "default": 0, "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "text", "id": "cs_line", "label": "Line above the email box", "default": "Get on the list and you'll see it first.", "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "text", "id": "cs_button", "label": "Button label", "default": "Sign me up", "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "text", "id": "cs_success", "label": "Thank-you message", "default": "You're on the list. Thanks.", "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "range", "id": "cs_width", "label": "Sign-up width", "min": 240, "max": 560, "step": 5, "unit": "px", "default": 440, "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "range", "id": "cs_top", "label": "Sign-up up (−) / down (+)", "min": -80, "max": 80, "step": 2, "unit": "px", "default": -40, "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "range", "id": "cs_bottom", "label": "Space below the sign-up", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40, "visible_if": "{{ section.settings.centre == 'signup' }}" },
    { "type": "checkbox", "id": "fill_height", "label": "Fill the screen", "default": false, "visible_if": "{{ section.settings.centre == 'signup' }}" }
  ],
  "presets": [ { "name": "WD Studio banner" } ]
}
