{%- comment -%}
  WALLY DOMO — Signup with an optional pointing hand (carnival-sign style). Used by the WD Gallery grid Text block.
  Hand: draw it pointing RIGHT, one ink, transparent PNG. Desktop: beside the form, pointing at it. Phones: above it, turned to point down.
  Params: fid (unique id), line, button, success, tags, hand (image), hand_side ('left' | 'right'), hand_width (px), nudge (true/false)
  Type: the line above the form = Theme settings > Type: Body & UI > Signup line; thank-you / error = Form fields.
{%- endcomment -%}
{%- liquid
  assign hw = hand_width | default: 140
  assign hw_m = hw | times: 0.6 | round
  assign har = 2
  if hand != blank
    assign har = hand.aspect_ratio
  endif
  assign side = hand_side | default: 'left'
-%}
<div class="wd-signup wd-signup--hand-{{ side }}{% if nudge %} wd-signup--nudge{% endif %}" style="--wd-hand-w: {{ hw }}px; --wd-hand-w-m: {{ hw_m }}px; --wd-hand-ar: {{ har }};">
  {%- if hand != blank -%}
    <div class="wd-signup__hand">{{ hand | image_url: width: 800 | image_tag: widths: '200, 400, 600, 800', sizes: '260px', alt: '', loading: 'lazy', class: 'wd-signup__hand-img' }}</div>
  {%- elsif request.design_mode -%}
    <div class="wd-signup__hand wd-signup__hand--placeholder" aria-hidden="true"><span>Pointing hand · draw it pointing right</span></div>
  {%- endif -%}
  <div class="wd-signup__form">
    {%- if line != blank -%}
      <p class="wd-signup__cta">{{ line | escape }}</p>
    {%- endif -%}
    {%- form 'customer', id: fid -%}
      <input type="hidden" name="contact[tags]" value="{{ tags | default: 'newsletter' }}">
      {%- if form.posted_successfully? -%}
        <p class="wd-signup__msg" tabindex="-1">{{ success | default: "You're on the list. Thanks." | escape }}</p>
      {%- else -%}
        <div class="wd-signup__row">
          <div class="field">
            <input id="{{ fid }}-email" type="email" name="contact[email]" class="field__input" value="{{ form.email }}" placeholder="Email" autocomplete="email" autocorrect="off" autocapitalize="off" aria-required="true" required{% if form.errors %} aria-invalid="true" aria-describedby="{{ fid }}-error"{% endif %}>
            <label class="field__label" for="{{ fid }}-email">Email</label>
          </div>
          <button type="submit" class="button wd-signup__button">{{ button | default: 'Sign me up' | escape }}</button>
        </div>
        {%- if form.errors -%}
          <small id="{{ fid }}-error" class="wd-signup__msg wd-signup__msg--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</small>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</div>
<style>
  .wd-signup { display: flex; align-items: center; gap: 24px; }
  .wd-signup--hand-right .wd-signup__hand { order: 2; }
  .wd-signup--hand-right .wd-signup__hand-img { transform: scaleX(-1); }
  .wd-signup__hand { flex: none; width: var(--wd-hand-w); }
  .wd-signup__hand-img { display: block; width: 100%; height: auto; }
  .wd-signup__hand--placeholder { aspect-ratio: 2 / 1; display: flex; align-items: center; justify-content: center; padding: 6px; border: 1px dashed rgba(var(--color-foreground), .35); font-size: 11px; letter-spacing: .06em; line-height: 1.3; text-align: center; opacity: .7; }
  .wd-signup__form { display: flex; flex-direction: column; gap: 10px; flex: 1; min-width: 0; max-width: 440px; }
  html body .wd-signup__cta { margin: 0; {% render 'wd-type-rule', el: 'signup' %} }
  .wd-signup__row { display: flex; gap: 10px; align-items: stretch; }
  .wd-signup__row .field { flex: 1; min-width: 0; }
  .wd-signup__button { flex: none; }
  html body .wd-signup__msg { margin: 0; {% render 'wd-type-rule', el: 'form' %} }
  .wd-signup__msg--error { display: block; margin-top: 8px; }
  .wd-signup--nudge .wd-signup__hand { animation: wd-signup-poke 2.4s ease-in-out infinite; }
  .wd-signup--nudge.wd-signup--hand-right .wd-signup__hand { animation-name: wd-signup-poke-l; }
  @keyframes wd-signup-poke { 0%, 30%, 100% { transform: translateX(0); } 8%, 22% { transform: translateX(8px); } 15% { transform: translateX(3px); } }
  @keyframes wd-signup-poke-l { 0%, 30%, 100% { transform: translateX(0); } 8%, 22% { transform: translateX(-8px); } 15% { transform: translateX(-3px); } }
  @keyframes wd-signup-poke-d { 0%, 30%, 100% { transform: translateY(0); } 8%, 22% { transform: translateY(6px); } 15% { transform: translateY(2px); } }
  @media screen and (max-width: 749px) {
    .wd-signup { flex-direction: column; align-items: flex-start; gap: 8px; }
    .wd-signup--hand-right .wd-signup__hand { order: 0; }
    .wd-signup__hand { position: relative; width: calc(var(--wd-hand-w-m) / var(--wd-hand-ar)); height: var(--wd-hand-w-m); }
    .wd-signup__hand-img, .wd-signup--hand-right .wd-signup__hand-img { position: absolute; top: 50%; left: 50%; width: var(--wd-hand-w-m); max-width: none; transform: translate(-50%, -50%) rotate(90deg); }
    .wd-signup__hand--placeholder { aspect-ratio: auto; font-size: 9px; }
    .wd-signup--nudge .wd-signup__hand, .wd-signup--nudge.wd-signup--hand-right .wd-signup__hand { animation-name: wd-signup-poke-d; }
    .wd-signup__form { width: 100%; max-width: none; }
    .wd-signup__row { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .wd-signup__hand { animation: none !important; } }
</style>
